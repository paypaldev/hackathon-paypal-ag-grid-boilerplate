# ==============================================================================
# VeriSettle AI — Environment Configuration Template
# Copy this file to .env.local: cp .env.example .env.local
# All secrets remain strictly server-side. Never prefix with NEXT_PUBLIC_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PayPal Sandbox Developer Credentials
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
# Create a REST App with Orders v2, Invoicing, and Disputes permissions.
# ------------------------------------------------------------------------------
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_SECRET=your_sandbox_client_secret
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ------------------------------------------------------------------------------
# 2. PayPal Webhook Configuration
# Register your endpoint (e.g. https://your-domain.com/api/paypal/webhook) in
# developer.paypal.com -> Apps & Credentials -> Webhooks, and paste the Webhook ID.
# ------------------------------------------------------------------------------
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id

# ------------------------------------------------------------------------------
# 3. Google Gemini Multimodal AI
# Obtain from https://aistudio.google.com/docs/api-key
# Used for multimodal invoice accounting field extraction and dispute defense rebuttals.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key

# ------------------------------------------------------------------------------
# 4. Channel3 Universal B2B Product Catalog & Pricing Intelligence
# Obtain from https://trychannel3.com/
# Powers multi-merchant catalog discovery (CDW, Newegg, Adorama) & price norm z-scores.
# ------------------------------------------------------------------------------
CHANNEL3_API_KEY=your_channel3_api_key

# ------------------------------------------------------------------------------
# 5. Machine Learning Intelligence Microservice
# Python FastAPI service running LayoutLMv3, XGBoost, and EV economic controllers.
# ML_MODE options:
#  - 'auto'   : Tries Python FastAPI first; falls back to pure TS engine if unavailable
#  - 'live'   : Enforces Python FastAPI microservice execution
#  - 'cached' : Runs instant (<5ms) deterministic TypeScript ML engine
# ------------------------------------------------------------------------------
ML_SERVICE_URL=http://localhost:8000
ML_MODE=auto

# ------------------------------------------------------------------------------
# 6. Optional: AG Studio & OpenAI Assistant
# AG_STUDIO=your_license_key
# AG_STUDIO_OPENAI_API_KEY=your_openai_key
# ------------------------------------------------------------------------------
