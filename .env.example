# PayPal Sandbox Developer Credentials
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_SECRET=your_sandbox_client_secret
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id

# AI & Sponsor API Keys
GEMINI_API_KEY=your_gemini_api_key
CHANNEL3_API_KEY=your_channel3_api_key

# Machine Learning Intelligence Service Config
# ML_MODE: 'cached' (zero-latency pure TS fallback, <5ms) or 'live' (Python FastAPI LayoutLMv3 + XGBoost + GNN)
ML_SERVICE_URL=http://localhost:8000
ML_MODE=cached
