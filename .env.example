# ==============================================================================
# RestockPilot — Environment Configuration Template
# Copy this file to .env.local: cp .env.example .env.local
# All secrets remain strictly server-side. Never prefix with NEXT_PUBLIC_.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PayPal Sandbox Developer Credentials
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
# REST App with Orders v2 ("CAPTURE" intent) permissions.
# ------------------------------------------------------------------------------
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_client_secret
PAYPAL_SECRET=your_sandbox_client_secret
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_ENV=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ------------------------------------------------------------------------------
# 2. PayPal Webhook Configuration
# Register your live URL (e.g. https://your-domain.com/api/paypal/webhook) in
# developer.paypal.com -> Apps & Credentials -> Webhooks, and paste Webhook ID.
# ------------------------------------------------------------------------------
PAYPAL_WEBHOOK_ID=your_sandbox_webhook_id

# ------------------------------------------------------------------------------
# 3. Channel3 Multi-Retailer Product Discovery API
# Obtain from https://trychannel3.com/
# Powers live supplier search, multi-merchant comparisons, and peer median calculation.
# ------------------------------------------------------------------------------
CHANNEL3_API_KEY=your_channel3_api_key

# ------------------------------------------------------------------------------
# 4. Google Gemini Multimodal AI
# Obtain from https://aistudio.google.com/docs/api-key
# Used for owner plain-English mandate parsing and offer explanation.
# (Resilient model chain automatically falls back if rate limits occur)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key

# ------------------------------------------------------------------------------
# 5. Optional AI Providers (Fallback Chain)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key
OPENAI_API_KEY=your_openai_api_key
